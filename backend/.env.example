# ============================================
# EMAIL CONFIGURATION (for Password Reset)
# ============================================

# Email Service Provider Settings
# For Gmail: smtp.gmail.com, port 587
# For SendGrid: smtp.sendgrid.net, port 587
# For Outlook: smtp-mail.outlook.com, port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Email Credentials
# For Gmail: Use App Password (https://support.google.com/accounts/answer/185833)
# For SendGrid: Use API key as password
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Email From Name (displayed in emails)
EMAIL_FROM_NAME=CRM System

# ============================================
# FRONTEND URL (for Password Reset Links)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/database_name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tricrm

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
JWT_SECRET=your-secret-key-here-please-change-this-in-production
NODE_ENV=development
